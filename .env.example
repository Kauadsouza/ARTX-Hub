# Crie um projeto no Supabase e copie estes valores em .env.local.
NEXT_PUBLIC_SUPABASE_URL=
# Use a chave Publishable. Em projetos antigos, a chave anon também funciona.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# URLs publicadas dos sistemas que o Hub abre.
NEXT_PUBLIC_SITE_URL=https://kauaartx.vercel.app
NEXT_PUBLIC_VIDEOS_URL=
NEXT_PUBLIC_SAT_URL=

# Opcional: ativa a Jade, a inteligência do Hub (fora do modo local do app
# desktop). Sem esta chave, a aba mostra "ainda não configurado" e o resto
# do Hub continua funcionando normalmente.
ANTHROPIC_API_KEY=
